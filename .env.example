# Servidor
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
DATABASE_PATH=./data/nexus.db
# Em producao use o Neon/Postgres. Quando DATABASE_URL existe, o Nexus ignora o SQLite.
DATABASE_URL=

# Imagens no Cloudinary. Se ficar vazio, o Nexus salva imagens localmente.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nexus

# Midia no Cloudflare R2. Quando completo, o Nexus usa R2 antes do Cloudinary.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nexus-media

# Opcional: importacao automatica local do Gerador de Contas Roblox.
# Nao envie este arquivo com contas reais para o GitHub.
ROBLOX_ACCOUNTS_FILE=./data/roblox-accounts.txt

# RushMail (Temp Email). Crie a chave em https://rushmail.dev/dashboard.
# Cada chamada bem-sucedida, exceto GET /me, consome 1 credito.
RUSHMAIL_API_KEY=
RUSHMAIL_API_URL=https://rushmail.dev/public-api

# ChatBot Nexus (Groq). Mantenha esta chave somente no servidor.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# LivePix. Crie uma aplicacao em Configuracoes > API e habilite payments:write.
# Nunca coloque essas credenciais no frontend, Discord ou GitHub.
LIVEPIX_CLIENT_ID=
LIVEPIX_CLIENT_SECRET=
LIVEPIX_SCOPE=payments:write
LIVEPIX_OAUTH_URL=https://oauth.livepix.gg/oauth2/token
LIVEPIX_API_URL=https://api.livepix.gg
LIVEPIX_REDIRECT_URL=http://localhost:5173

# Discord OAuth2
DISCORD_CLIENT_ID=seu_client_id
DISCORD_CLIENT_SECRET=seu_client_secret
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
# Use "implicit" para login local sem Client Secret, ou "code" para producao com Client Secret.
DISCORD_OAUTH_FLOW=implicit
# Opcional para a aba Discord Tools e para preencher nome/avatar ao criar uma licenca.
# Tambem publica o comando /conta do bot de vendas. Configure no Render e nunca no GitHub.
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_GUILD_ID=
# Canal onde o bot publica os Change Logs do Nexus. Deixe vazio para apenas
# registrar no painel/API ate o canal ser configurado.
NEXUS_CHANGELOG_CHANNEL_ID=
# Ative tambem no Discord Developer Portal antes de usar true.
DISCORD_MESSAGE_CONTENT_INTENT=false
DISCORD_GUILD_MEMBERS_INTENT=false

# Interface Discord -> API Nexus. Use o mesmo segredo forte somente no backend.
NEXUS_BOT_API_ID=nexus-discord-bot
NEXUS_BOT_API_SECRET=
NEXUS_BOT_API_URL=http://localhost:4000
# Separados por virgula. Vazio permite que owner/admin configure pelo /nexus painel.
NEXUS_BOT_ALLOWED_GUILD_IDS=
NEXUS_BOT_ALLOWED_CHANNEL_IDS=
NEXUS_BOT_OWNER_IDS=

# Segredos
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_MASTER_KEY=base64_com_32_bytes
APP_MASTER_KEY_ID=primary
# JSON com chaves antigas para rotacao: {"old-2026":"base64..."}
APP_PREVIOUS_MASTER_KEYS=
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=segredo_longo_para_sessoes
# Segredo HMAC separado para tickets e identificadores de seguranca.
LOADER_TICKET_SECRET=
LICENSE_EVENT_RETENTION_DAYS=90

# Rate limits do licenciamento/loader (todos configuraveis)
RATE_LIMIT_REDEEM_ATTEMPTS=5
RATE_LIMIT_REDEEM_WINDOW_SECONDS=900
RATE_LIMIT_LICENSE_QUERIES=15
RATE_LIMIT_LICENSE_QUERY_WINDOW_SECONDS=60
RATE_LIMIT_HWID_RESETS=3
RATE_LIMIT_HWID_RESET_WINDOW_SECONDS=3600
RATE_LIMIT_LOADER_VALIDATIONS=20
RATE_LIMIT_LOADER_VALIDATION_WINDOW_SECONDS=60
RATE_LIMIT_LOADER_TICKETS=10
RATE_LIMIT_LOADER_TICKET_WINDOW_SECONDS=60
RATE_LIMIT_TICKET_CONSUME_ATTEMPTS=5
RATE_LIMIT_BOT_COOLDOWN_SECONDS=2

# Whitelist inicial. O primeiro ID vira owner se nenhum papel for informado.
# Formato: discordId[:owner|admin|member],discordId[:owner|admin|member]
AUTHORIZED_DISCORD_IDS=123456789012345678:owner,987654321098765432:member

# Seguranca de producao
REQUIRE_HTTPS=false
# No Render use true para o Express reconhecer HTTPS e o IP encaminhado pelo proxy.
TRUST_PROXY=false

# A Square Cloud acompanha automaticamente novos commits da branch main.
